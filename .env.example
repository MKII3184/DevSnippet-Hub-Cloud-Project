# Application Port & Environment
PORT=8080
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# Database Configuration
# Leave empty to use embedded SQLite file in ./data/devsnippet.db
# Or set PostgreSQL connection string for Azure / Cloud Deployment:
# DATABASE_URL=postgres://username:password@psql-devsnippet-server.postgres.database.azure.com:5432/devsnippet_db?sslmode=require
DATABASE_URL=
DB_PATH=./data/devsnippet.db
